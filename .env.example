#project api
CRON_SECRET= # uses for this projects's cronjob private api routes secret token
API_SECRET_TOKEN= # uses for this project's private api routes
################

# Redis Cache Configuration
REDIS_HOST=localhost # Redis server host
REDIS_PORT=6379 # Redis server port
REDIS_PASSWORD= # Redis password (if required)
REDIS_DB=0 # Redis database number
REDIS_ENABLED=true # Enable Redis caching
################

# Flight Provider Configuration
FLIGHT_PROVIDER_PRIMARY=amadeus # Primary flight provider (amadeus, sabre, static)
FLIGHT_PROVIDER_FALLBACK=static # Fallback flight provider
FLIGHT_CACHE_ENABLED=true # Enable flight data caching
FLIGHT_CACHE_TTL_SEARCH=600 # Search cache TTL in seconds
FLIGHT_CACHE_TTL_AVAILABILITY=60 # Availability cache TTL in seconds
FLIGHT_CACHE_TTL_PRICING=180 # Pricing cache TTL in seconds
################

# Amadeus API Configuration
AMADEUS_ENABLED=false # Enable Amadeus integration
AMADEUS_API_KEY= # Amadeus API key
AMADEUS_API_SECRET= # Amadeus API secret
AMADEUS_BASE_URL=https://test.api.amadeus.com/v1 # Amadeus API base URL
AMADEUS_RATE_LIMIT=100 # Rate limit per minute
################

# next-auth (unused; will be used in the future)
AUTH_TRUST_HOST=true
AUTH_SECRET= # random string minimum 32 bytes required for next auth
AUTH_GOOGLE_ID= # Google client ID for login with google
AUTH_GOOGLE_SECRET= # Google client secret for login with google
AUTH_FACEBOOK_ID= # Facebook client ID for login with Facebook
AUTH_FACEBOOK_SECRET= # Facebook client secret for login with Facebook
AUTH_APPLE_ID= # Apple client ID for login with Apple
AUTH_APPLE_SECRET= # Apple client secret for login with Apple
#################

# mail send
MAIL_SENDER_EMAIL= # SENDER email address. Email you want to send with.
MAIL_API_TOKEN= # Mailjet send api token
MAIL_SECRET_TOKEN= # Mailjet secret token

# Payment Configuration
DEFAULT_PAYMENT_PROVIDER=stripe # stripe, razorpay, or paypal
DEFAULT_CURRENCY=USD # Default currency
SUPPORTED_CURRENCIES=USD,INR,EUR,GBP # Supported currencies
ENABLE_SAVED_PAYMENT_METHODS=true # Enable saved payment methods
ENABLE_REFUNDS=true # Enable refunds
ENABLE_WEBHOOKS=true # Enable webhooks
ENABLE_MULTI_CURRENCY=true # Enable multi-currency support
PAYMENT_LOGGING_ENABLED=true # Enable payment logging
PAYMENT_LOG_LEVEL=info # Payment log level
SENSITIVE_DATA_MASKING=true # Mask sensitive data in logs
WEBHOOK_TIMEOUT=30000 # Webhook timeout in milliseconds
MAX_PAYMENT_RETRIES=3 # Maximum payment retries
IDEMPOTENCY_WINDOW=3600 # Idempotency window in seconds
NEXT_PUBLIC_COMPANY_LOGO= # Company logo URL for payment forms
